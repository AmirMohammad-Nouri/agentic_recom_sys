# Copy to .env (or export) and adjust. Every service is optional; see README "Degradation".

# Most settings live in foodrec.config.json (Config page: foodrec config open). The file wins over
# these variables; null in the file means "use the variable". Secrets stay here only.

# API keys for hosted models (llm.provider openai / anthropic). The config names the variable
# in llm.api_key_env; the key itself is never written to the config file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Protects the Config page and study administration when the app is reachable by others.
# FOODREC_ADMIN_TOKEN=

# Supervisor model (Ollama). Sized for a 4 GB GPU; see README "Choosing the supervisor model".
FOODREC_LLM=1
OLLAMA_URL=http://127.0.0.1:11434
FOODREC_LLM_MODEL=qwen3.5:2b-q4_K_M
FOODREC_LLM_CTX=8192
FOODREC_LLM_THINK=0
FOODREC_LLM_TIMEOUT=60
# Embeddings for the vector store; run on CPU so the supervisor keeps the GPU.
FOODREC_EMBED_MODEL=nomic-embed-text
FOODREC_EMBED_CPU=1

# Knowledge graph. Leave NEO4J_URI empty for the in-process graph.
NEO4J_URI=
# NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# Vector store: "local" (embedded Qdrant on disk), "memory" (numpy), or a server URL.
FOODREC_QDRANT=local

FOODREC_DATA_DIR=data/runtime
FOODREC_MAX_STEPS=3
FOODREC_HOST=127.0.0.1
FOODREC_PORT=8000
