    "model": "qwen3.5:2b-q4_K_M",
    "url": null,
    "base_url": null,
    "api_key_env": null,
    "effort": "low",
    "max_tokens": 4096,
    "fallbacks": true,
    "ctx": 8192,
    "think": false,
    "timeout_s": 60,
    "seed": 7,
    "embed_provider": "ollama",
    "embed_model": "nomic-embed-text",
    "embed_on_cpu": true
  },
  "dataset": {
    "catalogue_path": "data/hummus/catalogue.json.gz",
    "knowledge_dir": "data/knowledge",
    "data_dir": "data/runtime"
  },
