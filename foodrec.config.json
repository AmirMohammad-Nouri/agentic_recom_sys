    "max_missing_share": 0.5,
    "hide_saved": true,
    "fatigue_per_view": 0.03,
    "fatigue_max": 0.12,
    "fatigue_half_life_days": 2,
    "cuisine_fatigue_per_slot": 0.01,
    "cuisine_fatigue_max": 0.06,
    "history_lists": 3,
    "discovery_slots": 0,
