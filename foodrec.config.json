          "assistant": true,
          "agent_trace": false,
          "explanations": false,
          "score_breakdown": false,
          "utility": true,
          "food_details": true,
          "images": true,
          "feedback": true,
          "supervisor": true,
          "weight_controls": true,
          "page_insights": true,
          "page_knowledge": true,
          "page_activity": true,
          "page_profile": true,
          "export_own": true,
          "switch_user": false,
          "configure": false
