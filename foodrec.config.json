        "visible_criteria": "all",
        "blocked_skills": []
      },
      "full": {
        "label": "Full transparency",
        "description": "All explanations, scores and the assistant.",
        "features": {
          "assistant": true,
          "agent_trace": true,
          "explanations": true,
          "score_breakdown": true,
          "utility": true,
          "food_details": true,
          "images": true,
          "feedback": true,
          "supervisor": true,
          "weight_controls": true,
          "page_insights": true,
          "page_knowledge": true,
          "page_activity": true,
          "page_profile": true,
          "export_own": true,
          "switch_user": false,
          "configure": false
