{
  "name": "reza_safety_rules",
  "description": "Reza's mandatory rules are never bent: a new allergy said in chat is only prepared, and applied only when he confirms. His own household note becomes searchable knowledge.",
  "user": "reza",
  "config": {"llm": {"enabled": false}},
  "steps": [
    {"action": "onboard",
     "declared": {"allergens": ["crustaceans"], "preferred_cuisines": ["Italian", "Thai"], "liked_ingredients": ["mushrooms"],
                  "disliked_ingredients": [{"name": "olives", "strict": true}, {"name": "cabbage", "strict": false}],
                  "max_ingredients": {"value": 10, "strict": true}},
     "weights": {"h": 0.3, "s": 0.2, "t": 0.5}},
    {"action": "expect", "that": "state.constraints.length", "equals": 3, "label": "three mandatory rules: crustaceans, olives, 10 ingredients"},
    {"action": "recommend"},
    {"action": "expect", "that": "result.results.length", "equals": 5},
    {"action": "chat", "text": "I'm allergic to gluten"},
    {"action": "expect", "that": "chat.decisions.length", "equals": 1, "label": "the allergy is prepared as a change to confirm"},
    {"action": "expect", "that": "state.profile.version", "equals": 1, "label": "nothing is applied before confirming"},
    {"action": "resolve", "decision": "latest:profile_change", "do": "accept"},
    {"action": "expect", "that": "state.profile.declared.allergens", "contains": "gluten"},
    {"action": "expect", "that": "state.constraints.length", "equals": 4},
    {"action": "recommend"},
    {"action": "expect", "that": "result.comparison", "exists": true},
    {"action": "chat", "text": "Something with mushrooms under 20 minutes"},
    {"action": "chat", "text": "Compare #1 and #2"},
    {"action": "expect", "that": "chat.skills", "contains": "compare_recipes"},
    {"action": "add_document", "title": "Household note",
     "text": "We buy tofu in bulk at the Asian market every Saturday, so tofu dishes are cheap for us. Our oven is broken until November, so avoid baked dishes."},
    {"action": "chat", "text": "Is our oven working?"},
    {"action": "expect", "that": "chat.skills", "contains": "search_knowledge"},
    {"action": "feedback", "recipe": "#1", "type": "reject", "reason": "not_my_taste"},
    {"action": "chat", "text": "What did I reject this week?"},
    {"action": "expect", "that": "chat.skills", "contains": "history"}
  ]
}
